# Supabase client, used by the panel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_AUTH_ENABLED=false

# Supabase server credentials, used only by the bot/server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# WhatsApp bot.
BOT_ENABLED=false
BOT_INSTANCE_ID=main
BOT_INSTANCE_LABEL=WhatsApp principal
BOT_SESSION_PATH=./whatsapp-session
BOT_POLL_INTERVAL_MS=5000
BOT_STATUS_HEARTBEAT_MS=120000
BOT_QR_RUNTIME_PERSIST_MS=120000
BOT_DEFAULT_COUNTRY_CODE=55
BOT_AUDIO_DIR=./media/audio
BOT_QR_PATH=./runtime/whatsapp-qr.png
BOT_QR_TEXT_PATH=./runtime/whatsapp-qr.txt
BOT_STATUS_PATH=./runtime/bot-status.json
BOT_HTTP_ENABLED=true
BOT_HTTP_HOST=0.0.0.0
BOT_HTTP_PORT=3001
BOT_PROTOCOL_TIMEOUT_MS=300000
BOT_OUTBOUND_ALLOWED_PREFIXES=ollama_watchdog:,site_bot:,media/audio/mentoria-prime/

# Optional second WhatsApp service for Mentoria Prime.
# Use these values only in the separate systemd service, not in the current main bot service.
MENTORIA_BOT_INSTANCE_ID=mentoria_prime
MENTORIA_BOT_INSTANCE_LABEL=WhatsApp Mentoria Prime
MENTORIA_BOT_SESSION_PATH=./whatsapp-session-mentoria-prime
MENTORIA_BOT_QR_PATH=./runtime/mentoria-prime/whatsapp-qr.png
MENTORIA_BOT_QR_TEXT_PATH=./runtime/mentoria-prime/whatsapp-qr.txt
MENTORIA_BOT_STATUS_PATH=./runtime/mentoria-prime/bot-status.json
MENTORIA_BOT_HTTP_PORT=3002
MENTORIA_BOT_OUTBOUND_ALLOWED_PREFIXES=site_bot:mentoria_prime:,media/audio/mentoria-prime/
EC10_FOLLOWUPS_ENABLED=false
EC10_GOOGLE_MEET_URL=
MEETING_REMINDER_LEAD_MINUTES=10
GOOGLE_MEET_OPEN_ACCESS_LOOKAHEAD_MINUTES=10
GOOGLE_MEET_OPEN_ACCESS_LOOKBACK_DAYS=365
# OAuth token with Google Meet scope. Prefer refresh-token flow for daily automation.
# Required scope: https://www.googleapis.com/auth/meetings.space.settings
GOOGLE_MEET_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
EC10_SELLER_NAME=Igor Jardins
EC10_SELLER_PHONE=+55 31 8233-1411
EC10_PUBLIC_SITE_URL=https://ec10talentos.com
CHROME_EXECUTABLE_PATH=

# Optional AI assist. For the free EC10 pilot, use Groq with Zero Data Retention enabled.
BOT_AI_ENABLED=true
BOT_AI_PROVIDER=ollama
BOT_AI_FALLBACK_ENABLED=true
BOT_AI_FALLBACK_DAILY_LIMIT=250
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_AUDIO_MODEL=gemma4:e2b
OLLAMA_WATCHDOG_REPLY_COOLDOWN_MINUTES=720
OLLAMA_KEEP_ALIVE=5m
OLLAMA_REQUEST_TIMEOUT_MS=30000
OLLAMA_AUDIO_TIMEOUT_MS=180000
OLLAMA_NUM_CTX=2048
OLLAMA_AUDIO_NUM_CTX=4096
OLLAMA_MAX_AUDIO_BYTES=8000000
OLLAMA_AUDIO_MAX_SECONDS=90
OLLAMA_AUDIO_MAX_OUTPUT_TOKENS=1600
OLLAMA_WATCHDOG_MODEL=qwen3:4b
OLLAMA_WATCHDOG_LIMIT=20
OLLAMA_WATCHDOG_STALE_QUEUE_MINUTES=20
OLLAMA_WATCHDOG_REPLY_DELAY_MINUTES=3
OLLAMA_WATCHDOG_AUTO_REPLY=true
OLLAMA_WATCHDOG_MIN_CONFIDENCE=82
OLLAMA_WATCHDOG_MAX_REPLIES_PER_RUN=3
OLLAMA_WATCHDOG_TIMEOUT_MS=60000
OLLAMA_WATCHDOG_NUM_CTX=2048
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_SECONDARY_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_REQUEST_TIMEOUT_MS=18000
GROQ_MAX_AUDIO_BYTES=20000000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_AUDIO_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_AUDIO_BYTES=8000000

# Optional local transcription endpoint for later.
WHISPER_BASE_URL=

# Traffic AI and Meta Ads. Keep real values only in local/Vercel secrets.
BASE44_TRAFFIC_AGENT_URL=
BASE44_TRAFFIC_AGENT_API_KEY=
TRAFFIC_AI_PROVIDER=ollama
TRAFFIC_OLLAMA_MODEL=qwen3.5:4b
TRAFFIC_OLLAMA_NUM_CTX=4096
TRAFFIC_OLLAMA_TIMEOUT_MS=120000
TRAFFIC_OLLAMA_MAX_OUTPUT_TOKENS=1200
META_GRAPH_VERSION=v25.0
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
