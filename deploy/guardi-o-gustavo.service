[Unit]
Description=Guardiao Gustavo EC10 - recupera conversas sem resposta
After=network-online.target cliente-whatsapp-crm-bot.service
Wants=network-online.target

[Service]
Type=oneshot
User=opc
WorkingDirectory=/home/opc/cliente-whatsapp-crm
Environment=PYTHONPATH=/home/opc/ec10-gustavo-v2/.venv/lib/python3.9/site-packages
Environment=GUSTAVO_GUARDIAN_RECOVERY_ENABLED=false
ExecStart=/usr/bin/bash -lc 'runtime_dir="$(/usr/bin/systemctl show cliente-whatsapp-crm-bot.service -p WorkingDirectory --value)"; exec /usr/bin/python3 "$runtime_dir/scripts/guardi_o_gustavo.py"'
SuccessExitStatus=2 3
