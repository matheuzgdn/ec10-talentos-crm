[Unit]
Description=EC10 encrypted PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/ec10-crm-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ec10-crm /run
TimeoutStartSec=20min
