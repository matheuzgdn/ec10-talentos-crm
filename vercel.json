{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/painel/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/me",
      "destination": "/api/auth?mode=me"
    },
    {
      "source": "/api/booking-calendar",
      "destination": "/api/booking?mode=calendar"
    },
    {
      "source": "/api/meta-whatsapp-webhook",
      "destination": "/api/messages?whatsapp_cloud=1"
    },
    {
      "source": "/api/meta-whatsapp-onboarding",
      "destination": "/api/messages?whatsapp_onboarding=1"
    },
    {
      "source": "/api/bot-connect",
      "destination": "/bot-connect.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/x1",
      "destination": "/api/create-client?public=x1"
    },
    {
      "source": "/sudamerica-x1",
      "destination": "/api/create-client?public=sudamerica-x1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
